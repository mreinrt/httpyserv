# -------------------------------------------------
# HTTP HANDLER
# -------------------------------------------------
class CustomHTTPRequestHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        self.serve_directory = kwargs.pop("serve_directory")
        self.log_callback = kwargs.pop("log_callback", None)
        super().__init__(*args, **kwargs)

    def translate_path(self, path):
        relative = super().translate_path(path)
        return os.path.join(
            self.serve_directory,
            os.path.relpath(relative, os.getcwd())
        )

    def log_message(self, format, *args):
        client_ip = self.client_address[0]
        message = "%s - %s" % (client_ip, format % args)
        if self.log_callback:
            GLib.idle_add(self.log_callback, message)

    def do_GET(self):
        try:
            super().do_GET()
        except ConnectionResetError:
            # Client disconnected, just log it and continue
            print(f"Client {self.client_address} disconnected prematurely")
        except BrokenPipeError:
            print(f"Broken pipe for client {self.client_address}")
    
    # Also override the copyfile method for more granular control
    def copyfile(self, source, outputfile):
        try:
            super().copyfile(source, outputfile)
        except (ConnectionResetError, BrokenPipeError):
            print(f"Connection lost while sending to {self.client_address}")

# -------------------------------------------------
# GTK HTTP SERVER
# -------------------------------------------------
class HTTPServerGTK:
    def __init__(self):
        self.server = None
        self.server_thread = None
        self.is_running = False
        self.serve_directory = os.getcwd()

        # Apply CSS fix
        self.apply_button_text_fix()

        # Initialize UI
        self.setup_ui()

        # Load configuration
        self.load_config()

        # Window close event
        self.window.connect("delete-event", self.on_window_delete)
        self.window.connect("destroy", Gtk.main_quit)

    # -------------------------------------------------
    # STATUS LOGGING
    # -------------------------------------------------
    def log_status(self, message):
        """Log messages to the GTK server status widget (only HTTP events should use this)."""
        timestamp = datetime.now().strftime("%H:%M:%S")
        buffer = self.status_text.get_buffer()
        buffer.insert(buffer.get_end_iter(), f"[{timestamp}] {message}\n")

    # -------------------------------------------------
    # CONFIG
    # -------------------------------------------------
    def get_config_path(self):
        config_dir = Path.home() / ".config" / "httpfileserver"
        return config_dir / "config.ini"

    def load_config(self):
        config = configparser.ConfigParser()
        config_path = self.get_config_path()
        if config_path.exists():
            config.read(config_path)
            if "Settings" in config:
                settings = config["Settings"]
                if "serve_directory" in settings:
                    self.serve_directory = settings["serve_directory"]
                if "host" in settings:
                    self.host_entry.set_text(settings["host"])
                if "port" in settings:
                    self.port_entry.set_text(settings["port"])
                if "show_hidden" in settings:
                    self.show_hidden_check.set_active(settings.getboolean("show_hidden"))
        self.dir_path.set_text(self.serve_directory)
        self.refresh_file_list()

    def save_config(self):
        config = configparser.ConfigParser()
        config["Settings"] = {
            "serve_directory": self.dir_path.get_text(),
            "host": self.host_entry.get_text(),
            "port": self.port_entry.get_text(),
            "show_hidden": str(self.show_hidden_check.get_active())
        }
        config_path = self.get_config_path()
        config_path.parent.mkdir(parents=True, exist_ok=True)
        with open(config_path, "w") as f:
            config.write(f)

    def on_window_delete(self, widget, event):
        self.save_config()
        return False

    # -------------------------------------------------
    # CSS
    # -------------------------------------------------
    def apply_button_text_fix(self):
        css_provider = Gtk.CssProvider()
        css = """
        button.suggested-action label,
        button.suggested-action {
            color: black;
            text-shadow: 0 1px 1px rgba(0,0,0,0.5);
        }
        button.destructive-action label,
        button.destructive-action {
            color: white;
            text-shadow: 0 1px 1px rgba(0,0,0,0.5);
        }
        """
        try:
            css_provider.load_from_data(css.encode())
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(),
                css_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
        except Exception as e:
            print(f"CSS application warning: {e}")

    # -------------------------------------------------
    # UI
    # -------------------------------------------------
    def setup_ui(self):
        self.window = Gtk.Window(title="HTTPYSERV - HTTP File Server")
        self.window.set_default_size(1000, 750)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_border_width(10)

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.window.add(main_box)

        # Directory selection
        dir_frame = Gtk.Frame(label="Server Directory")
        main_box.pack_start(dir_frame, False, False, 0)

        dir_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        dir_box.set_margin_top(10)
        dir_box.set_margin_bottom(10)
        dir_box.set_margin_start(10)
        dir_box.set_margin_end(10)
        dir_frame.add(dir_box)

        self.dir_path = Gtk.Entry()
        self.dir_path.set_text(self.serve_directory)
        self.dir_path.set_hexpand(True)
        dir_box.pack_start(self.dir_path, True, True, 0)

        browse_btn = Gtk.Button(label="Browse")
        browse_btn.connect("clicked", self.on_browse_clicked)
        dir_box.pack_start(browse_btn, False, False, 0)

        refresh_btn = Gtk.Button(label="Refresh")
        refresh_btn.connect("clicked", self.on_refresh_clicked)
        dir_box.pack_start(refresh_btn, False, False, 0)

        # Server settings
        settings_frame = Gtk.Frame(label="Server Settings")
        main_box.pack_start(settings_frame, False, False, 0)

        settings_grid = Gtk.Grid()
        settings_grid.set_margin_top(10)
        settings_grid.set_margin_bottom(10)
        settings_grid.set_margin_start(10)
        settings_grid.set_margin_end(10)
        settings_grid.set_column_spacing(10)
        settings_frame.add(settings_grid)

        host_label = Gtk.Label(label="Host:")
        settings_grid.attach(host_label, 0, 0, 1, 1)

        self.host_entry = Gtk.Entry()
        self.host_entry.set_text("0.0.0.0")
        settings_grid.attach(self.host_entry, 1, 0, 1, 1)

        port_label = Gtk.Label(label="Port:")
        settings_grid.attach(port_label, 2, 0, 1, 1)

        self.port_entry = Gtk.Entry()
        self.port_entry.set_text("8000")
        settings_grid.attach(self.port_entry, 3, 0, 1, 1)

        # Controls
        control_box = Gtk.Box(spacing=10)
        main_box.pack_start(control_box, False, False, 0)

        self.start_btn = Gtk.Button(label="Start Server")
        self.start_btn.get_style_context().add_class("suggested-action")
        self.start_btn.connect("clicked", self.on_start_clicked)
        control_box.pack_start(self.start_btn, False, False, 0)

        self.stop_btn = Gtk.Button(label="Stop Server")
        self.stop_btn.get_style_context().add_class("destructive-action")
        self.stop_btn.set_sensitive(False)
        self.stop_btn.connect("clicked", self.on_stop_clicked)
        control_box.pack_start(self.stop_btn, False, False, 0)

        open_btn = Gtk.Button(label="Open in Browser")
        open_btn.connect("clicked", self.on_open_clicked)
        control_box.pack_start(open_btn, False, False, 0)

        # Server Status
        status_frame = Gtk.Frame(label="Server Status")
        main_box.pack_start(status_frame, True, True, 0)

        scrolled_status = Gtk.ScrolledWindow()
        scrolled_status.set_vexpand(True)
        scrolled_status.set_hexpand(True)
        status_frame.add(scrolled_status)

        self.status_text = Gtk.TextView()
        self.status_text.set_editable(False)
        self.status_text.set_cursor_visible(False)
        scrolled_status.add(self.status_text)

        # Directory Contents
        file_frame = Gtk.Frame(label="Directory Contents")
        main_box.pack_start(file_frame, True, True, 0)

        file_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        file_frame.add(file_vbox)

        filter_box = Gtk.Box(spacing=5)
        file_vbox.pack_start(filter_box, False, False, 0)

        filter_label = Gtk.Label(label="Filter:")
        filter_box.pack_start(filter_label, False, False, 0)

        self.filter_entry = Gtk.Entry()
        self.filter_entry.set_hexpand(True)
        self.filter_entry.connect("changed", self.on_filter_changed)
        filter_box.pack_start(self.filter_entry, True, True, 0)

        self.show_hidden_check = Gtk.CheckButton(label="Show Hidden Files")
        self.show_hidden_check.connect("toggled", self.on_filter_changed)
        filter_box.pack_start(self.show_hidden_check, False, False, 0)

        scrolled_tree = Gtk.ScrolledWindow()
        scrolled_tree.set_vexpand(True)
        file_vbox.pack_start(scrolled_tree, True, True, 0)

        self.file_store = Gtk.ListStore(str)
        self.tree_view = Gtk.TreeView(model=self.file_store)

        renderer = Gtk.CellRendererText()
        column = Gtk.TreeViewColumn("Name", renderer, text=0)
        self.tree_view.append_column(column)

        scrolled_tree.add(self.tree_view)
        self.refresh_file_list()
        self.window.show_all()

    # -------------------------------------------------
    # EVENTS
    # -------------------------------------------------
    def on_browse_clicked(self, widget):
        dialog = Gtk.FileChooserDialog(
            title="Select Directory",
            parent=self.window,
            action=Gtk.FileChooserAction.SELECT_FOLDER
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL,
            Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN,
            Gtk.ResponseType.OK
        )
        dialog.set_current_folder(self.serve_directory)
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            self.serve_directory = dialog.get_filename()
            self.dir_path.set_text(self.serve_directory)
            self.refresh_file_list()
            self.save_config()
        dialog.destroy()

    def on_refresh_clicked(self, widget):
        self.refresh_file_list()

    def on_filter_changed(self, widget):
        # Just refresh list, do NOT log anything
        self.refresh_file_list()

    # -------------------------------------------------
    # DIRECTORY LIST
    # -------------------------------------------------
    def refresh_file_list(self):
        self.file_store.clear()
        directory = self.dir_path.get_text()
        filter_text = self.filter_entry.get_text().lower()
        show_hidden = self.show_hidden_check.get_active()

        if not os.path.isdir(directory):
            return

        try:
            items = os.listdir(directory)
            for item in sorted(items, key=str.lower):
                if not show_hidden and item.startswith("."):
                    continue
                if filter_text and filter_text not in item.lower():
                    continue
                self.file_store.append([item])
        except Exception as e:
            pass

    # -------------------------------------------------
    # SERVER
    # -------------------------------------------------
    def run_server_thread(self, host, port, directory):
        os.chdir(directory)
        handler = lambda *args, **kwargs: CustomHTTPRequestHandler(
            *args,
            serve_directory=directory,
            log_callback=self.log_status,  # only HTTP events
            **kwargs
        )
        self.server = HTTPServer((host, port), handler)
        self.log_status(f"Server started on {host}:{port}")
        self.server.serve_forever()

    def on_start_clicked(self, widget):
        host = self.host_entry.get_text()
        port = int(self.port_entry.get_text())
        directory = self.dir_path.get_text()

        self.server_thread = threading.Thread(
            target=self.run_server_thread,
            args=(host, port, directory),
            daemon=True
        )
        self.server_thread.start()
        self.start_btn.set_sensitive(False)
        self.stop_btn.set_sensitive(True)
        self.is_running = True
        self.save_config()

    def on_stop_clicked(self, widget):
        if self.server:
            self.server.shutdown()
            self.server.server_close()
        self.start_btn.set_sensitive(True)
        self.stop_btn.set_sensitive(False)
        self.log_status("Server stopped")

    def on_open_clicked(self, widget):
        import webbrowser
        port = self.port_entry.get_text()
        webbrowser.open(f"http://localhost:{port}/")


def main():
    HTTPServerGTK()
    Gtk.main()


if __name__ == "__main__":
    main()